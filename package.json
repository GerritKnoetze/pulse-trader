{
  "name": "pulse-trader",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "migrate:up": "npx tsx src/server/scripts/migrate.ts up",
    "migrate:down": "npx tsx src/server/scripts/migrate.ts down",
    "migrate:status": "npx tsx src/server/scripts/migrate.ts status",
    "migrate:list": "npx tsx src/server/scripts/migrate.ts list",
    "migrate:create": "npx tsx src/server/scripts/migrate.ts create",
    "migrate:validate": "npx tsx src/server/scripts/migrate.ts validate",
    "favicons": "node scripts/generate-favicons.mjs",
    "migrate:reset": "npx tsx src/server/scripts/migrate.ts reset",
    "test": "vitest run",
    "test:chart": "vitest run tests/chart-updates.test.ts",
    "test:data": "npx tsx scripts/data-layer-test.tsx",
    "test:data:online": "npx tsx scripts/data-layer-test.tsx --online",
    "test:data:live": "npx tsx scripts/data-layer-test.tsx --live"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@massive.com/client-js": "^10.5.0",
    "better-sqlite3": "^12.8.0",
    "commander": "^14.0.3",
    "lightweight-charts": "^4.2.3",
    "nuxt": "^4.3.1",
    "vue": "^3.5.29",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.2",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "vitest": "^4.1.11"
  }
}
